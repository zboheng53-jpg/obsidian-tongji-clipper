{
  "manifest_version": 3,
  "name": "同济课程逐字稿采集器",
  "version": "1.0.0",
  "description": "同济大学Look平台课程音视频逐字稿本地采集与转写扩展",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "notifications",
    "alarms"
  ],
  "options_page": "dashboard.html",
  "host_permissions": [
    "https://look.tongji.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://look.tongji.edu.cn/*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://look.tongji.edu.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "同济逐字稿采集"
  }
}
